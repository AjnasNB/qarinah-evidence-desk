# Copy needed settings into gitignored .env.local. Keep real values out of chat.
# No account creation or provider request is performed by this example.
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Set true only after authorizing inference with existing credits.
QED_ENABLE_NEMOTRON=false
# Optional private local runtime directory. Default: .local/evidence-desk.
QED_DATA_DIR=
