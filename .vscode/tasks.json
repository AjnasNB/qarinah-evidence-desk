{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Qarinah: validate",
      "type": "process",
      "command": "node",
      "args": ["scripts/validate.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Qarinah: dev",
      "type": "process",
      "command": "node",
      "args": ["scripts/dev.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Qarinah: test",
      "type": "process",
      "command": "node",
      "args": ["scripts/test.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Qarinah: typecheck",
      "type": "process",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "--project", "tsconfig.json"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    }
  ]
}
